{
  "name": "@tamga/sdk",
  "version": "0.2.1",
  "description": "Official JavaScript/TypeScript SDK for Tamga. Integrate license activation, offline verification, and machine management into Node.js, Deno, Bun, and browser applications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.2",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamga-sh/tamga-js.git"
  },
  "homepage": "https://github.com/tamga-sh/tamga-js#readme",
  "bugs": {
    "url": "https://github.com/tamga-sh/tamga-js/issues"
  },
  "keywords": [
    "tamga",
    "licensing",
    "license-key",
    "software-licensing",
    "sdk"
  ]
}
